+// SPDX-License-Identifier: GPL-3.0-only WITH GPL-3.0-linking-exception
+// Assemble build/preview/index.html from sdk/Update.html.in (as Build-Web.ps1 -LocalPreview does).
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+const root = process.argv[2] || path.resolve(path.dirname(new URL(import.meta.url).pathname), '..');
+const rd = f => fs.readFileSync(path.join(root, f), 'utf8');
+const sha = b => crypto.createHash('sha256').update(b).digest('hex');
+const version = /#define FM1_RELEASE_VERSION "([^"]+)"/.exec(rd('app/version.h'))[1];
+const wasm = fs.readFileSync(path.join(root, 'build/web/simulator.wasm'));
+const sim = {schema:1, release_version:version, sha256:sha(wasm), source_sha256:sha(wasm),
+  sample_bank:'synthesized-demo', data:wasm.toString('base64')};
+let web = rd('sdk/Update.html.in');
+web = web.replace(/<a\b[^>]*href="\/\*FM1_SOURCE_URL\*\/"[^>]*>(.*?)<\/a>/g, '<span>$1 (local preview)</span>');
+const esc = s => s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
+const notices = ['APP: GPLv3 with the FM1 SDK linking exception; no warranty. SDK and firmware resources have separate redistribution terms in THIRD_PARTY.md. Source: local preview'];
+for (const f of ['THIRD_PARTY.md','LICENSE.md']) notices.push(`\n===== ${f} =====\n` + rd(f));
+const rep = {
+  '/*FM1_SOURCE_URL*/': '',
+  '/*FM1_PAYLOAD*/': 'const FM1_PACKAGE = null;',
+  '/*FM1_SIMULATOR*/': 'const FM1_SIMULATOR = ' + JSON.stringify(sim) + ';',
+  '/*FM1_I18N*/': rd('sdk/I18n.js'),
+  '/*FM1_SCRIPT*/': rd('sdk/WebUpdate.js'),
+  '/*FM1_SIM_SCRIPT*/': rd('sdk/Simulator.js'),
+  '/*FM1_SAMPLE_SCRIPT*/': rd('sdk/Samples.js'),
+  '/*FM1_NOTICES*/': esc(notices.join('\n')),
+};
+for (const [k, v] of Object.entries(rep)) web = web.split(k).join(v);
+if (/\/\*FM1_[A-Z_]+\*\//.test(web)) throw new Error('Unexpanded HTML placeholder');
+fs.mkdirSync(path.join(root, 'build/preview'), {recursive:true});
+fs.writeFileSync(path.join(root, 'build/preview/index.html'), web);
+console.log('Preview: build/preview/index.html', (web.length/1024|0) + ' KiB');
diff --git a/tools/build-web.sh b/tools/build-web.sh
new file mode 100755
index 0000000..f8daf0d
--- /dev/null
+++ b/tools/build-web.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: GPL-3.0-only WITH GPL-3.0-linking-exception
+# Linux/macOS port of tools/Build-Web.ps1 -LocalPreview.
+# Builds the browser simulator (build/web/simulator.wasm) and a single-file
+# preview (build/preview/index.html). Needs WASI SDK 27 and Node 18+.
+#   FM1_WASI_SDK=/path/to/wasi-sdk-27.0-x86_64-linux ./tools/build-web.sh
+set -euo pipefail
+root="$(cd "$(dirname "$0")/.." && pwd)"
+sdk="${FM1_WASI_SDK:-}"
+[ -n "$sdk" ] && [ -x "$sdk/bin/clang" ] || { echo "Set FM1_WASI_SDK to an extracted WASI SDK 27" >&2; exit 2; }
+mkdir -p "$root/build/web" "$root/build/preview"
+sources=()
+while IFS= read -r f; do sources+=("$f"); done < <(
+  cd "$root" && find app web third_party/synth -type f -name '*.c' ! -path 'app/board/*' | LC_ALL=C sort)
+inc=()
+for d in web/engine web/synth third_party/synth sdk/include app/synth app; do inc+=("-I$root/$d"); done
+abs=(); for s in "${sources[@]}"; do abs+=("$root/$s"); done
+echo "Compile the browser application (${#sources[@]} files)"
+"$sdk/bin/clang" --sysroot="$sdk/share/wasi-sysroot" -std=c11 -O2 -fwrapv -fno-fast-math -ffp-contract=off \
+  -DFM1_HOST_TEST -DFM1_OPEN_WEB -Wall -Wextra -Werror -Wno-unused-function -Wno-array-parameter \
+  -mexec-model=reactor "${inc[@]}" "${abs[@]}" \
+  -Wl,--strip-all -Wl,-z,stack-size=131072 -Wl,--initial-memory=4194304 -Wl,--max-memory=33554432 \
+  -o "$root/build/web/simulator.wasm"
+node "$root/tools/assemble-preview.mjs" "$root"
+node "$root/tools/theme-workbench.mjs" "$root/build/preview/index.html"
diff --git a/tools/lcd-shot.mjs b/tools/lcd-shot.mjs
new file mode 100644
index 0000000..50478de
--- /dev/null
+++ b/tools/lcd-shot.mjs
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-3.0-only WITH GPL-3.0-linking-exception
+// Drive the simulator headlessly and save LCD screenshots as PNG.
+//   node tools/lcd-shot.mjs out_dir script...
+// Script steps: wait:ms  btn:index  hold:index:ms  enc:index:delta  key:index:ms
+//               open:page  midi:hex,hex,..  boot  shot:name  prog:n
+import fs from 'node:fs';
+import zlib from 'node:zlib';
+import { Sim } from './sim-node.mjs';
+const [out, ...steps] = process.argv.slice(2);
+fs.mkdirSync(out, { recursive: true });
+const sim = new Sim(new URL('../build/web/simulator.wasm', import.meta.url).pathname);
+const ms = n => sim.render(Math.ceil(n * 44.1 / sim.frames));
+function png(path, px) {
+  const raw = Buffer.alloc(240 * (240 * 3 + 1));
+  for (let y = 0; y < 240; ++y) {
+    raw[y * 721] = 0;
+    for (let x = 0; x < 240; ++x) {
+      const v = px[y * 240 + x], at = y * 721 + 1 + x * 3;
+      raw[at] = ((v >> 11) & 31) * 255 / 31; raw[at + 1] = ((v >> 5) & 63) * 255 / 63; raw[at + 2] = (v & 31) * 255 / 31;
+    }
+  }
+  const crcTable = Array.from({ length: 256 }, (_, n) => { let c = n; for (let k = 0; k < 8; ++k) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1; return c >>> 0; });
+  const crc = b => { let c = ~0; for (const x of b) c = crcTable[(c ^ x) & 255] ^ (c >>> 8); return (~c) >>> 0; };
+  const chunk = (type, data) => { const len = Buffer.alloc(4); len.writeUInt32BE(data.length); const td = Buffer.concat([Buffer.from(type), data]); const c = Buffer.alloc(4); c.writeUInt32BE(crc(td)); return Buffer.concat([len, td, c]); };
+  const ihdr = Buffer.alloc(13); ihdr.writeUInt32BE(240, 0); ihdr.writeUInt32BE(240, 4); ihdr[8] = 8; ihdr[9] = 2;
+  fs.writeFileSync(path, Buffer.concat([Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]), chunk('IHDR', ihdr), chunk('IDAT', zlib.deflateSync(raw)), chunk('IEND', Buffer.alloc(0))]));
+}
+ms(50);
+for (const step of steps) {
+  const [k, a, b] = step.split(':');
+  if (k === 'wait') ms(+a);
+  else if (k === 'boot') { sim.c.sim_boot(2); ms(10); }
+  else if (k === 'btn') { sim.control(0, +a, 1); ms(40); sim.control(0, +a, 0); ms(40); }
+  else if (k === 'hold') { sim.control(0, +a, 1); ms(+b); sim.control(0, +a, 0); ms(40); }
+  else if (k === 'enc') { sim.control(2, +a, +b); ms(20); sim.control(2, +a, 0); ms(20); }
+  else if (k === 'key') { sim.control(1, +a, 1); ms(+b || 300); sim.control(1, +a, 0); ms(30); }
+  else if (k === 'keydown') { sim.control(1, +a, 1); ms(30); }
+  else if (k === 'open') { sim.c.sim_open(+a); ms(60); }
+  else if (k === 'prog') { sim.midi(0xc0, +a); ms(30); }
+  else if (k === 'midi') { sim.midi(...a.split(',').map(x => parseInt(x, 16))); ms(10); }
+  else if (k === 'shot') { ms(80); png(`${out}/${a}.png`, sim.pixels()); }
+  else throw new Error('bad step ' + step);
+}
